  <body>



    <!-- CABEÃ‡ALHO FIXO -->



    <header class="reader-header">



      <button

        class="menu-button"

        id="menu-open"

        type="button"

        aria-label="Abrir menu"

        aria-expanded="false"

      >

        â˜°

      </button>



      <div class="header-title">
        {book?.name} {chapter}
      </div>

      <a class="header-comments" href={`/${bookSlug}/${chapterNumber}/comentarios/`} aria-label="Abrir comentários deste capÃ­tulo">
        Comentários
      </a>

      <div></div>



    </header>





    <!-- MENU -->



    <div

      class="menu-overlay"

      id="menu-overlay"

    ></div>



    <aside

      class="reader-menu"

      id="reader-menu"

      aria-label="Menu de leitura"

    >



      <div class="menu-header">



        <div class="menu-brand">

          fiBÃ­blia

        </div>



        <button

          class="menu-close"

          id="menu-close"

          type="button"

          aria-label="Fechar menu"

        >

          Ã—

        </button>



      </div>





      <div class="menu-content">



        <!-- TAMANHO -->



        <p class="menu-section-title">

          Tamanho da letra

        </p>



        <div class="font-controls-menu">



          <button

            class="font-button"

            id="font-decrease"

            type="button"

            aria-label="Diminuir letra"

          >

            Aâˆ’

          </button>



          <button

            class="font-button"

            id="font-reset"

            type="button"

            aria-label="Tamanho padrÃ£o"

          >

            A

          </button>



          <button

            class="font-button font-large"

            id="font-increase"

            type="button"

            aria-label="Aumentar letra"

          >

            A+

          </button>



        </div>





        <!-- LIVROS -->



        <p class="menu-section-title">

          Livros

        </p>



        <div class="books-list">



          {

            booksForMenu.map((menuBook) => (

              <details

                class:list={[

                  "book-item",

                  {

                    "current-book":

                      menuBook.slug === bookSlug

                  }

                ]}

                open={menuBook.slug === bookSlug}

              >



                <summary class="book-summary">

                  {menuBook.name}

                </summary>



                <div class="chapter-grid">



                  {

                    menuBook.chapters.map(

                      (menuChapter) => (

                        <a

                          class:list={[

                            "chapter-link",

                            {

                              current:

                                menuBook.slug ===

                                  bookSlug &&

                                menuChapter.chapter_number ===

                                  chapterNumber

                            }

                          ]}

                          href={`/${menuBook.slug}/${menuChapter.chapter_number}`}

                        >

                          {menuChapter.chapter_number}

                        </a>

                      )

                    )

                  }



                </div>



              </details>

            ))

          }



        </div>



      </div>



    </aside>





    <!-- CONTEÃšDO -->



    <main>



      {

        errorMessage ? (

          <p>{errorMessage}</p>

        ) : (

          <>



            <!-- TEXTO -->



            <ol>



              {

                verses.map((verse) => (

                  <li>

                    <span class="reader-text">

                      {verse.text}

                    </span>

                  </li>

                ))

              }



            </ol>

                        <!-- REFLEXÃ•ES FILOSÃ“FICAS -->



            {

              editorialContents && editorialContents.length > 0 && (

                <section

                  id="comentarios-filosoficos"

                  class="editorial-section" hidden

                >

                  <h2>ReflexÃµes filosÃ³ficas</h2>



                  {editorialContents.map((item) => (

                    <article class="editorial-content">

                      <h3>{item.title}</h3>



                      {item.verse_start && item.verse_end && (

                        <p class="editorial-reference">

                          ReferÃªncia: {book.name} {chapterNumber}:

                          {item.verse_start}â€“{item.verse_end}

                        </p>

                      )}



                      <div class="editorial-text">

                        {item.content}

                      </div>

                    </article>

                  ))}

                </section>

              )

            }



            <!-- NAVEGAÇÃO FINAL -->



            <nav>



              {

                previousUrl ? (

                  <a href={previousUrl}>

                    â† Anterior

                  </a>

                ) : (

                  <span>

                    â† Anterior

                  </span>

                )

              }



              {

                nextUrl ? (

                  <a href={nextUrl}>

                    PrÃ³ximo â†’

                  </a>

                ) : (

                  <span>

                    PrÃ³ximo â†’

                  </span>

                )

              }



            </nav>



          </>

        )

      }





      <script>

        /* ================================

           MENU

        ================================= */



        const menu =

          document.getElementById("reader-menu");



        const overlay =

          document.getElementById("menu-overlay");



        const openButton =

          document.getElementById("menu-open");



        const closeButton =

          document.getElementById("menu-close");





        function openMenu() {

          menu?.classList.add("open");

          overlay?.classList.add("open");



          openButton?.setAttribute(

            "aria-expanded",

            "true"

          );



          document.body.style.overflow = "hidden";

        }





        function closeMenu() {

          menu?.classList.remove("open");

          overlay?.classList.remove("open");



          openButton?.setAttribute(

            "aria-expanded",

            "false"

          );



          document.body.style.overflow = "";

        }





        openButton?.addEventListener(

          "click",

          openMenu

        );



        closeButton?.addEventListener(

          "click",

          closeMenu

        );



        overlay?.addEventListener(

          "click",

          closeMenu

        );





        /* ESC FECHA MENU */



        document.addEventListener(

          "keydown",

          (event) => {

            if (event.key === "Escape") {

              closeMenu();

            }

          }

        );





        /* ================================

           TAMANHO DA LETRA

        ================================= */



        const decreaseButton =

          document.getElementById(

            "font-decrease"

          );



        const resetButton =

          document.getElementById(

            "font-reset"

          );



        const increaseButton =

          document.getElementById(

            "font-increase"

          );





        const defaultSize = 1.3;



        const minimumSize = 1.1;



        const maximumSize = 1.8;



        const step = 0.1;





        function setFontSize(size: number) {



          const finalSize =

            Math.min(

              maximumSize,

              Math.max(

                minimumSize,

                size

              )

            );





          document

            .querySelectorAll(

              ".reader-text"

            )

            .forEach(

              (element) => {



                (

                  element as HTMLElement

                ).style.fontSize =

                  `${finalSize}rem`;



              }

            );





          localStorage.setItem(

            "fibiblia-font-size",

            String(finalSize)

          );

        }





        const savedSize =

          Number(

            localStorage.getItem(

              "fibiblia-font-size"

            )

          );





        setFontSize(

          savedSize || defaultSize

        );





        decreaseButton?.addEventListener(

          "click",

          () => {



            const currentSize =

              Number(

                localStorage.getItem(

                  "fibiblia-font-size"

                )

              ) || defaultSize;





            setFontSize(

              currentSize - step

            );



          }

        );





        resetButton?.addEventListener(

          "click",

          () => {



            setFontSize(

              defaultSize

            );



          }

        );





        increaseButton?.addEventListener(

          "click",

          () => {



            const currentSize =

              Number(

                localStorage.getItem(

                  "fibiblia-font-size"

                )

              ) || defaultSize;





            setFontSize(

              currentSize + step

            );



          }

        );





        /* ================================

           AO ESCOLHER UM CAPÃTULO

           FECHA O MENU

        ================================= */



        document

          .querySelectorAll(

            ".chapter-link"

          )

          .forEach(

            (link) => {



              link.addEventListener(

                "click",

                () => {

                  closeMenu();

                }

              );



            }

          );

      </script>



    </main>



  </body>

</html>