import { supabase } from "../../lib/supabase";



interface Book {

  id: string;

  name: string;

  slug: string;

  book_order: number;

}



interface Chapter {

  id: string;

  book_id: string;

  chapter_number: number;

}



interface Verse {

  chapter_id: string;

  verse_number: number;

  text: string;

}



interface PageProps {

  book: Book;

  chapter: string;

  chapterNumber: number;

  verses: Verse[];

  previousUrl: string | null;

  nextUrl: string | null;

  booksForMenu: Array<

    Book & {

      chapters: Chapter[];

    }

  >;

}





/*

 * ============================================================

 * GERAÃ‡ÃƒO DAS 1.189 ROTAS

 * ============================================================

 */



export async function getStaticPaths() {

  /*

   * ----------------------------------------------------------

   * 1. LIVROS

   * ----------------------------------------------------------

   */



  const { data: books, error: booksError } = await supabase

    .from("books")

    .select("id, name, slug, book_order")

    .order("book_order");



  if (booksError || !books) {

  throw new Error(

    `Não foi possÃ­vel carregar os livros: ${booksError?.message ?? "dados nÃ£o retornados"}`

  );

}





  /*

   * ----------------------------------------------------------

   * 2. CAPÃTULOS

   * ----------------------------------------------------------

   *

   * O Supabase pode limitar uma consulta a 1000 registros.

   * Como temos 1.189 capÃ­tulos, usamos range.

   */



  let chaptersError: any = null;



const allChapters: {

  id: string;

  book_id: string;

  chapter_number: number;

}[] = [];



const chapterBatchSize = 1000;



for (let from = 0; ; from += chapterBatchSize) {

  const { data: chapterBatch, error } = await supabase

    .from("chapters")

    .select("id, book_id, chapter_number")

    .order("book_id")

    .order("chapter_number")

    .range(from, from + chapterBatchSize - 1);



  if (error) {

    chaptersError = error;

    break;

  }



  allChapters.push(...(chapterBatch ?? []));



  if (!chapterBatch || chapterBatch.length < chapterBatchSize) {

    break;

  }

}



const chapters = allChapters;



  if (chaptersError || !chapters) {

    throw new Error("Não foi possÃ­vel carregar os capÃ­tulos.");

  }





  /*

   * ----------------------------------------------------------

   * 3. VERSÃO BÃBLIA LIVRE

   * ----------------------------------------------------------

   */



  const { data: version, error: versionError } = await supabase

    .from("bible_versions")

    .select("id")

    .eq("abbreviation", "BL")

    .single();



  if (versionError || !version) {

    throw new Error("Versão bÃ­blica nÃ£o encontrada.");

  }





  /*

   * ----------------------------------------------------------

   * 4. TODOS OS VERSÃCULOS

   * ----------------------------------------------------------

   *

   * Carregamos em blocos de 1000.

   */



  const allVerses: Verse[] = [];



  const pageSize = 1000;



  for (let from = 0; ; from += pageSize) {

    const { data, error } = await supabase

      .from("verses")

      .select("chapter_id, verse_number, text")

      .eq("version_id", version.id)

      .order("chapter_id")

      .order("verse_number")

      .range(from, from + pageSize - 1);



    if (error) {

      throw new Error(

        "Não foi possÃ­vel carregar os versÃ­culos."

      );

    }



    const page = data ?? [];



    allVerses.push(...page);



    if (page.length < pageSize) {

      break;

    }

  }





  /*

   * ----------------------------------------------------------

   * 5. MAPA DE CAPÃTULOS POR LIVRO

   * ----------------------------------------------------------

   */



  const chaptersByBookId = new Map<string, Chapter[]>();



  for (const chapter of chapters) {

    const existing = chaptersByBookId.get(chapter.book_id);



    if (existing) {

      existing.push(chapter);

    } else {

      chaptersByBookId.set(chapter.book_id, [chapter]);

    }

  }





  /*

   * ----------------------------------------------------------

   * 6. MAPA DE VERSÃCULOS POR CAPÃTULO

   * ----------------------------------------------------------

   */



  const versesByChapterId = new Map<string, Verse[]>();



  for (const verse of allVerses) {

    const existing =

      versesByChapterId.get(verse.chapter_id);



    if (existing) {

      existing.push(verse);

    } else {

      versesByChapterId.set(

        verse.chapter_id,

        [verse]

      );

    }

  }





  /*

   * ----------------------------------------------------------

   * 7. MENU COMPLETO

   * ----------------------------------------------------------

   */



  const booksForMenu = books.map((book) => ({

    ...book,

    chapters:

      chaptersByBookId.get(book.id) ?? [],

  }));





  /*

   * ----------------------------------------------------------

   * 8. GERA AS PÃGINAS

   * ----------------------------------------------------------

   */



  const paths = [];



  for (const book of books) {

    const bookChapters =

      chaptersByBookId.get(book.id) ?? [];



    for (let index = 0; index < bookChapters.length; index++) {

      const currentChapter = bookChapters[index];



      /*

       * ------------------------------------------------------

       * CAPÃTULO ANTERIOR

       * ------------------------------------------------------

       */



      let previousUrl: string | null = null;



      if (index > 0) {

        const previousChapter =

          bookChapters[index - 1];



        previousUrl =

          `/${book.slug}/${previousChapter.chapter_number}`;

      } else if (book.book_order > 1) {

        const previousBook = books.find(

          (item) =>

            item.book_order === book.book_order - 1

        );



        if (previousBook) {

          const previousBookChapters =

            chaptersByBookId.get(previousBook.id) ?? [];



          const lastChapter =

            previousBookChapters[

              previousBookChapters.length - 1

            ];



          if (lastChapter) {

            previousUrl =

              `/${previousBook.slug}/${lastChapter.chapter_number}`;

          }

        }

      }





      /*

       * ------------------------------------------------------

       * PRÓXIMO CAPÃTULO

       * ------------------------------------------------------

       */



      let nextUrl: string | null = null;



      if (index < bookChapters.length - 1) {

        const nextChapter =

          bookChapters[index + 1];



        nextUrl =

          `/${book.slug}/${nextChapter.chapter_number}`;

      } else {

        const nextBook = books.find(

          (item) =>

            item.book_order === book.book_order + 1

        );



        if (nextBook) {

          nextUrl =

            `/${nextBook.slug}/1`;

        }

      }





      /*

       * ------------------------------------------------------

       * DADOS DA PÃGINA

       * ------------------------------------------------------

       */



      paths.push({

        params: {

          book: book.slug,

          chapter: String(

            currentChapter.chapter_number

          ),

        },



        props: {

          book,

          chapter: String(

            currentChapter.chapter_number

          ),

          chapterNumber:

            currentChapter.chapter_number,



          verses:

            versesByChapterId.get(

              currentChapter.id

            ) ?? [],



          previousUrl,

          nextUrl,



          booksForMenu,

        } satisfies PageProps,

      });

    }

  }



  console.log(

    `fiBÃ­blia: ${books.length} livros, ${chapters.length} capÃ­tulos e ${allVerses.length} versÃ­culos carregados.`

  );



  return paths;

}





/*

 * ============================================================

 * DADOS RECEBIDOS PELA PÃGINA

 * ============================================================

 */



const {

  book,

  chapter,

  chapterNumber,

  verses,

  previousUrl,

  nextUrl,

  booksForMenu,

} = Astro.props as PageProps;



const bookSlug = book.slug;



const isLocal = import.meta.env.DEV;



const { data: currentChapter, error: chapterError } = await supabase

  .from("chapters")

  .select("id")

  .eq("book_id", book.id)

  .eq("chapter_number", chapterNumber)

  .single();



const { data: editorialContents, error: editorialError } = currentChapter

  ? await supabase

      .from("editorial_contents")

      .select("id, title, type, verse_start, verse_end, content, status")

      .eq("chapter_id", currentChapter.id)

      .in("status", isLocal ? ["published", "draft"] : ["published"])

      .order("verse_start", { ascending: true })

  : { data: null, error: chapterError };



const errorMessage =

  editorialError || chapterError

    ? "Não foi possÃ­vel carregar os comentários filosÃ³ficos."

    : "";

